# RepoPilot Environment Configuration

# Server Settings
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO

# API Security / CORS
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
JWT_SECRET=change-this-in-production-super-secret-key-32-chars

# Storage Paths
STORAGE_DIR=./storage
VECTOR_STORE_DIR=./vector_indices

# Embedding Provider Configuration
EMBEDDING_PROVIDER=sentence-transformers # options: sentence-transformers, openai
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# LLM Provider Configuration
LLM_PROVIDER=mock # options: mock, openai, ollama
LLM_MODEL_NAME=gpt-4o-mini
OPENAI_API_KEY=your_openai_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
