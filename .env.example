# RepoPilot Environment Configuration Template
# Rename to .env before starting containers

# Environment
ENVIRONMENT=production
DEBUG=false

# Security & Authentication
JWT_SECRET=change-this-in-production-super-secret-jwt-key-32-chars

# LLM Provider Configuration
LLM_PROVIDER=mock
OPENAI_API_KEY=your-openai-api-key-here
EMBEDDING_PROVIDER=mock

# Database Configuration (PostgreSQL 16)
POSTGRES_USER=repopilot
POSTGRES_PASSWORD=repopilot_secure_password
POSTGRES_DB=repopilot_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Cache Configuration (Redis 7)
REDIS_HOST=redis
REDIS_PORT=6379

# Storage & Persistence Paths
STORAGE_DIR=/app/storage
VECTOR_STORE_DIR=/app/vector_indices
